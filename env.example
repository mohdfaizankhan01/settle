# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# PayPal sandbox REST app (developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Webhook ID from the sandbox app, used by verify-webhook-signature
PAYPAL_WEBHOOK_ID=
# Our platform (partner) account's merchant ID, for Partner Referrals seller onboarding
PAYPAL_PARTNER_MERCHANT_ID=

# Jev decision model
JEV_PROVIDER=
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
JEV_MODEL=

# Public base URL of this app (deal links, webhook URL)
SETTLE_PUBLIC_HOST=

# Postgres for deals and receipts (Render or Neon; TLS is used for both)
DATABASE_URL=
# Scam memory: random secret, at least 32 characters (openssl rand -hex 32). Without it in
# production, scam memory is off: nothing is stored or matched.
SETTLE_MEMORY_KEY=

# Optional: AG Studio licence key for /dashboard
AG_STUDIO=
# Optional: OpenAI key for the AG Studio assistant on /dashboard
AG_STUDIO_OPENAI_API_KEY=
# Optional: comma-separated OpenAI model ids for the assistant; first is the default
OPENAI_MODELS=

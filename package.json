    "model:fetch": "tsx scripts/fetch-model.ts",
    "proof": "tsx scripts/proof.mts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@bryntum/scheduler": "npm:@bryntum/scheduler-trial@7.3.8",
    "@bryntum/scheduler-react": "7.3.8",
    "@huggingface/transformers": "4.3.2",
    "@typesafe-ai/sdk": "^0.7.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "next": "16.3.8",
    "paypal": "git+https://github.com/context-plugins/paypal-typescript-sdk.git#5d0df8a8817e5fdf2e2cd48e68f790ea4730aab2",
    "pdf-lib": "1.17.1",
